{
  "expo": {
    "name": "Enter",
    "slug": "enter-client",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "enter",
    "icon": "./assets/enter-icon.png",
    "android": {
      "package": "com.enter.messenger"
    },
    "ios": {
      "bundleIdentifier": "com.enter.messenger",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
