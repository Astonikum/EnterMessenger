# Public branding exposed through /health and /.well-known/enter
ENTER_SERVER_NAME=Imagine.Enter
ENTER_SERVER_URL=http://127.0.0.1:50121
# Use a URL or let the server expose a local file at /server/logo
ENTER_SERVER_LOGO_URL=https://example.com/logo.png
# ENTER_SERVER_LOGO_PATH=C:/Enter/server-logo.png

# Storage: choose one backend
ENTER_DATABASE_URL=sqlite://server/data/enter.sqlite3
# ENTER_DATABASE_URL=postgres://enter:change-me@127.0.0.1:5432/enter

ENTER_PORT=50121
# Maximum plaintext size for one photo/video/file. Default: 200 MB.
# ENTER_MEDIA_MAX_MB=200
# Push relay for mobile background notifications (Expo-compatible by default).
# ENTER_EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# For LAN/mobile development use 0.0.0.0 and configure the firewall.
# ENTER_BIND_ADDRESS=0.0.0.0
